# ClearDeed — Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# ── ClearDeed Core ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://cleardeed.in
CLEARDEED_BASE_URL=https://cleardeed.in

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Razorpay (Test Mode) ─────────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
# Test credentials work with test.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_SpLuOfVZDAdnM4
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# For webhook signature verification (optional but recommended):
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── 2Captcha (CAPTCHA solving service) ─────────────────────────────────────────
# Get API key at: https://2captcha.com/developer
# NOT USED for IGR as of D-035 (2026-06-14) — local ddddocr ensemble is the solver.
# Kept here for CERSAI or other fallbacks.
TWO_CAPTCHA_API_KEY=your-2captcha-api-key

# ── Apify (court-records scraper for eCourts) ──────────────────────────────────
# Get API token at: https://console.apify.com/account/integrations
# Required for the eCourts fetcher (Task 1.2 — Layer 1.2).
# When set, packages/fetchers/ecourts/src/index.ts delegates to
# packages/fetchers/ecourts/src/via-apify.ts which calls the
# `parseforge/court-records-ecourt-india-scraper` actor. When unset, the
# fetcher returns `manual_required` with degradation_tag `ecourts_manual_required`.
APIFY_TOKEN=your_apify_token_here

# ── IGR Odisha Citizen Account ─────────────────────────────────────────────────
# Path 1 operational account (D-034). Registered by the founder at
# https://www.igrodisha.gov.in/Admin/Login/NEW/NewUser.aspx
# Required for IGR EC V2 fetcher automated login (D-035 captcha solver).
# Without these, the V2 fetcher falls back to "verify manually at the SRO" (V1).
IGR_CITIZEN_LOGIN_ID=your-igr-registered-login-id
IGR_CITIZEN_PASSWORD=your-igr-registered-password

# ── Resend (Email) ───────────────────────────────────────────────────────────
# Found in: resend.com → API Keys
# Free tier: 100 emails/day
RESEND_API_KEY=re_HiKaachK_CBK38uHAUK767Czw2wnwXtwJ

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Public token (pk.*) — safe to expose to the browser.
# Found at: https://account.mapbox.com/access-tokens/
# Required for: plot boundary map in the report view
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# ── Bhulekh Fetcher ─────────────────────────────────────────────────────────
# The fetcher uses Playwright. No credentials needed — bhulekh.ori.nic.in is public.
# Optional: proxy for rate limiting
# BHEULKH_PROXY_URL=

# ── Development overrides ────────────────────────────────────────────────────
# Set to "development" to enable verbose logging
NODE_ENV=development

# ── Admin ────────────────────────────────────────────────────────────────────
# Token for accessing /admin (deprecated — review queue removed)
# ADMIN_VIEW_TOKEN=your-admin-token