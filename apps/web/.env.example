# ClearDeed — Environment Variables
# Copy this to .env.local and fill in real values

# ── Supabase ────────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (never expose to client)
# Get this from Supabase: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Founder-only admin view.
# Set this in Vercel and open /admin?token=<value>. The route fails closed when unset.
ADMIN_VIEW_TOKEN=generate-a-long-random-token

# Optional separate token for POST /api/report/create.
# If omitted, ADMIN_VIEW_TOKEN is accepted for report creation.
REPORT_CREATE_TOKEN=generate-a-different-long-random-token

# ── Supabase Auth (T-013: phone-OTP login) ──────────────────────────────────────
# Configure the phone-OTP provider in your Supabase dashboard:
#   Authentication → Sign In/Up → Phone → ON
#   Authentication → Sign In/Up → SMS Provider → select "msg91" (or other)
#
# Without these, the /login page will fail with "sms provider not configured"
# when a buyer requests a code. Phone auth uses the E.164 format (+91XXXXXXXXXX).
#
# Site URL: Authentication → URL Configuration → set to your production domain.
#   For dev: http://localhost:3000
#   For prod: https://cleardeed.in
# Redirect URLs: add the same URLs plus http://localhost:3000/login.
#
# SMS provider (MSG91 in India) — set in Supabase dashboard, not as env vars:
#   - MSG91_AUTH_KEY (in Supabase's custom-SMS-hook config)
#   - MSG91_SENDER_ID (DLT-registered, e.g. "CDEEDIN")
#   - MSG91_TEMPLATE_ID (DLT-registered DLT template id)
# DLT registration is mandatory in India for any commercial SMS — see
# docs/sources/auth.md for the full setup checklist.

# ── Razorpay ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
#
# IMPORTANT — read this before you paste keys:
#   - TEST keys have prefix `rzp_test_*`. Use these for local development
#     and CI. They never charge real money.
#   - LIVE keys have prefix `rzp_live_*`. Use these only in production
#     (Vercel). Setting a live key with NODE_ENV=development or NODE_ENV=test
#     will cause /api/order to refuse to run and return HTTP 503. This is a
#     safety net against accidentally burning real money.
#
# RAZORPAY_KEY_ID is the server-side key (used to create orders).
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the client-side key (used by the
# Razorpay.js modal). They are normally the same value.
# RAZORPAY_KEY_SECRET is server-side only — never expose it to the client.
# RAZORPAY_WEBHOOK_SECRET is optional; setting it enables HMAC signature
# verification on /api/webhook/razorpay. Get it from the Razorpay dashboard
# under Webhooks → your endpoint → Secret.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
# Optional but recommended for production:
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── ClearDeed API ───────────────────────────────────────────────────────────────
# Optional: set a secret for rate limiting or webhook verification
# API_SECRET=your-secret-here

# Optional for production smoke checks.
# Defaults to https://v0-cleardeed.vercel.app when omitted.
CLEARDEED_BASE_URL=https://v0-cleardeed.vercel.app

# ── Mapbox (required for the in-report map in Section 1) ───────────────────────
# Get a public token from https://account.mapbox.com/access-tokens/
# The map will render a blank tile grid without this — set in Vercel before launch.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# ── Resend (transactional email) ───────────────────────────────────────────────
# Get an API key from https://resend.com/api-keys
# cleardeed.in domain must be verified in Resend → Domains before the post-payment
# email can be delivered. Without it, the email is silently dropped and the buyer
# only gets the in-band report.
RESEND_API_KEY=re_your_resend_api_key_here

# ── PID synthesis kill switch ─────────────────────────────────────────────────
# Default: false. Leave unset in production until Phase 1 observability data
# shows positive engagement signals.
# PID_SYNTHESIS_ENABLED=false
# PID_SIMILARITY_ENABLED=false

# ── Development ────────────────────────────────────────────────────────────────
# Set to "development" to enable verbose logging
NODE_ENV=development
