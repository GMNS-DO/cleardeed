{
  "name": "cleardeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @cleardeed/web dev",
    "build": "pnpm --filter @cleardeed/web build",
    "dev:all": "pnpm -r dev",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "pid:validate": "node pid/cli/validate_seeds.mjs",
    "pid:seed-sql": "node pid/cli/validate_seeds.mjs --sql-out=pid/schema/seed_pid_sources_and_patterns.sql",
    "pid:import-raw": "node pid/cli/import_raw_archive.mjs",
    "pid:patterns": "node pid/cli/generate_pattern_candidates.mjs",
    "pid:review-patterns": "node pid/cli/review_pattern_candidates.mjs",
    "pid:review": "node pid/cli/review_corpus_items.mjs",
    "pid:coverage": "node pid/cli/build_source_coverage.mjs",
    "pid:spine": "node pid/cli/build_plot_spine.mjs",
    "pid:queue": "node pid/cli/build_work_queue.mjs",
    "pid:extract-text": "node pid/cli/extract_artifact_text.mjs",
    "pid:ocr": "node pid/cli/ocr_pdf_artifacts.mjs",
    "pid:ocr-reuse": "node pid/cli/ocr_pdf_artifacts.mjs --reuse-only --limit=10000",
    "pid:ocr-facts": "node pid/cli/extract_ocr_facts.mjs",
    "pid:ec-leads": "node pid/cli/extract_ec_transaction_leads.mjs",
    "pid:ec-links": "node pid/cli/build_ec_link_suggestions.mjs",
    "pid:review-ec-links": "node pid/cli/review_ec_link_suggestions.mjs",
    "pid:mine-text": "node pid/cli/mine_text_signals.mjs",
    "pid:seed-review-set": "node pid/cli/select_seed_review_set.mjs --size=25",
    "pid:snapshot": "node pid/cli/snapshot_corpus.mjs",
    "pid:refresh": "node pid/cli/refresh_corpus.mjs",
    "verify:prod": "node scripts/verify-production-launch.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "next": "^15.0.0",
    "playwright": "^1.59.1",
    "pnpm": "^10.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vercel": "^54.0.0",
    "vitest": "^4.1.4",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "playwright-core": "^1.59.1",
    "tesseract.js": "^7.0.0"
  }
}
